    "# Correlación de features para modelos de predicción\n",
    "Este notebook analiza la correlación entre grupos de variables y el resultado de victoria/derrota para distintos conjuntos de features."
   ]
   "execution_count": null,
   "metadata": {},
   "outputs": [],
    "import numpy as np\n",
    "import seaborn as sns\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "PARQUET_PATH = \"/Users/pablo/Documents/BigData/BasketballAnalysis/00_data/00d_featurized/00a_WL_prediction/teamgamelogs.parquet\"\n",
    "TARGET = \"WL_NUM\"\n",
    "df = pd.read_parquet(PARQUET_PATH)\n",
    "if TARGET not in df.columns:\n",
    "    raise ValueError(f\"La columna objetivo '{TARGET}' no se encuentra en el dataset.\")\n",
    "print(f\"Shape del dataset: {df.shape}\")\n",
    "\n"
   ]
   "execution_count": null,
    "FEATURE_GROUPS = {\n",
    "    \"baseline\": [\n",
    "        # Métricas rolling/plus-minus básicas\n",
    "        \"ROLL10_PLUS_MINUS\",\n",
    "        \"ROLL10_OFF_RATING\",\n",
    "        \"ROLL10_DEF_RATING\",\n",
    "        \"ROLL10_NET_RATING\",\n",
    "        \"ROLL10_EFG_PCT\",\n",
    "        \"ROLL10_TS_PCT\",\n",
    "        # ← añade aquí nuevas columnas si las creas en el pipeline\n",
    "    ],\n",
    "    \"venue\": [\n",
    "        \"VENUE_HOME_W_PCT\",\n",
    "        \"VENUE_ROAD_W_PCT\",\n",
    "        # ← añade aquí nuevas columnas si las creas en el pipeline\n",
    "    ],\n",
    "    \"enhanced\": [\n",
    "        \"DAYS_REST\",\n",
    "        \"LAST_5_PCT\",\n",
    "        \"BACK_TO_BACK_FLAG\",\n",
    "        \"SEASON_W_PCT\",\n",
    "        \"PACE\",\n",
    "        \"TURNOVER_RATIO\",\n",
    "        \"AST_TOV\",\n",
    "        \"PIE\",\n",
    "        # ← añade aquí nuevas columnas si las creas en el pipeline\n",
    "    ],\n",
    "    \"elo\": [\n",
    "        \"ELO_PRE\",\n",
    "        \"ELO_OPP_PRE\",\n",
    "        \"ELO_DIFF_PRE\",\n",
    "        \"P_ELO_HOME\",\n",
    "        # ← añade aquí nuevas columnas si las creas en el pipeline\n",
    "    ],\n",
    "TOP_K = 5\n",
    "\n"
   ]
   "execution_count": null,
   "outputs": [],
    "def available_cols(df: pd.DataFrame, cols_list):\n",
    "    \"\"\"Devuelve columnas existentes y numéricas.\"\"\"\n",
    "    numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
    "    return [col for col in cols_list if col in numeric_cols]\n",
    "def corr_with_target(df: pd.DataFrame, cols, target: str) -> pd.DataFrame:\n",
    "    \"\"\"Calcula correlación de Pearson entre features y el target.\"\"\"\n",
    "    if not cols:\n",
    "        return pd.DataFrame(columns=[\"feature\", \"corr\", \"abs_corr\"])\n",
    "    data = df[cols + [target]]\n",
    "    corr_series = data.corr()[target].drop(labels=[target], errors=\"ignore\").dropna()\n",
    "    result = (\n",
    "        corr_series.reset_index()\n",
    "        .rename(columns={\"index\": \"feature\", target: \"corr\"})\n",
    "    )\n",
    "    if result.empty:\n",
    "        return pd.DataFrame(columns=[\"feature\", \"corr\", \"abs_corr\"])\n",
    "    result[\"abs_corr\"] = result[\"corr\"].abs()\n",
    "    return result.sort_values(\"abs_corr\", ascending=False).reset_index(drop=True)\n",
    "def topk_abs_corr(df_corr: pd.DataFrame, k: int = 5) -> pd.DataFrame:\n",
    "    \"\"\"Selecciona el top-k por correlación absoluta.\"\"\"\n",
    "    if df_corr.empty:\n",
    "        return df_corr\n",
    "    return df_corr.head(k)\n",
    "def plot_topk_heatmap(df: pd.DataFrame, features_topk, target: str) -> None:\n",
    "    \"\"\"Dibuja heatmap de correlaciones para las features top-k y el target.\"\"\"\n",
    "    if len(features_topk) < 2:\n",
    "        print(\"Menos de 2 columnas para heatmap; se omite la visualización.\")\n",
    "    subset_cols = features_topk + [target]\n",
    "    corr_matrix = df[subset_cols].corr()\n",
    "\n",
    "    plt.figure(figsize=(6, 4))\n",
    "    sns.heatmap(\n",
    "        corr_matrix,\n",
    "        annot=True,\n",
    "        fmt=\".2f\",\n",
    "        cmap=\"coolwarm\",\n",
    "        vmin=-1,\n",
    "        vmax=1,\n",
    "        square=True,\n",
    "        cbar_kws={\"shrink\": 0.8},\n",
    "    )\n",
    "    plt.title(\"Correlaciones (Top-K + Target)\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n"
   ]
    "## Resultados por modelo"
   ]
   "execution_count": null,
   "outputs": [],
    "for model in [\"baseline\", \"venue\", \"enhanced\", \"elo\"]:\n    model_upper = model.upper()\n    candidate_cols = FEATURE_GROUPS.get(model, [])\n    valid_cols = available_cols(df, candidate_cols)\n\n    print(f\"[{model_upper}] columnas válidas: {len(valid_cols)}\")\n    if not valid_cols:\n        print(\"No hay columnas numéricas disponibles para este modelo.\\n\")\n        continue\n\n    X_model = df[valid_cols]\n    model_df = pd.concat([X_model, df[[TARGET]]], axis=1).dropna()\n    print(f\"[{model_upper}] filas tras dropna: {len(model_df)}\")\n\n    if model_df.empty:\n        print(\"Datos vacíos tras eliminar NaN.\\n\")\n        continue\n\n    corr_df = corr_with_target(model_df, valid_cols, TARGET)\n    if corr_df.empty:\n        print(\"No se pudo calcular la correlación con el target.\\n\")\n        continue\n\n    top_corr = topk_abs_corr(corr_df, k=TOP_K)\n\n    display_df = top_corr[[\"feature\", \"corr\"]].copy()\n    display_df[\"corr\"] = display_df[\"corr\"].map(lambda x: f\"{x:.3f}\")\n\n    print(display_df.to_string(index=False))\n\n    top_features = top_corr[\"feature\"].tolist()\n    print(f\"[{model_upper}] Total columnas en el modelo: {len(valid_cols)}\")\n    print(f\"[{model_upper}] Columnas top-{TOP_K} por |corr|: {top_features}\\n\")\n\n    if len(valid_cols) < 2:\n        print(\"Menos de 2 columnas válidas; se omite heatmap.\\n\")\n        continue\n\n    plot_topk_heatmap(model_df, top_features, TARGET)\n"
   ]
    "## Cómo añadir nuevas columnas\n",
    "1. Incorpora la nueva feature en el pipeline de generación de datos para que aparezca en el parquet consolidado.\n",
    "2. Añade el nombre de la columna a la lista correspondiente en `FEATURE_GROUPS`.\n",
    "3. Vuelve a ejecutar el bloque de resultados por modelo para actualizar la selección de correlaciones."
   ]
