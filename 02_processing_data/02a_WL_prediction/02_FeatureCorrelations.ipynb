    "# === Calendario retrospectivo mínimo (en df) ===\n",
    "def compute_calendar_features(frame):\n",
    "    if 'GAME_DATE' not in frame.columns:\n",
    "        raise KeyError(\"La columna 'GAME_DATE' no está disponible en el dataset featurizado.\")\n",
    "    calendar_cols = ['DAYS_REST_CALC', 'IS_B2B_CALC', 'GAMES_IN_3D_CALC', 'GAMES_IN_5D_CALC', 'GAMES_IN_7D_CALC']\n",
    "\n",
    "    game_dates = pd.to_datetime(frame['GAME_DATE'], errors='coerce', utc=True)\n",
    "    frame = frame.copy()\n",
    "    frame['GAME_DATE'] = game_dates.dt.tz_convert(None)\n",
    "\n",
    "    sort_columns = [col for col in ['TEAM_ID', 'GAME_DATE', 'GAME_ID'] if col in frame.columns]\n",
    "    if len(sort_columns) < 3:\n",
    "        raise KeyError('No se encontraron todas las columnas necesarias para ordenar cronológicamente por equipo.')\n",
    "\n",
    "    ordered = frame.sort_values(sort_columns).reset_index(drop=True)\n",
    "    ordered['temp_index'] = range(len(ordered))\n",
    "    ordered['PREV_GAME_DATE'] = ordered.groupby('TEAM_ID')['GAME_DATE'].shift(1)\n",
    "    ordered['DAYS_REST_CALC'] = (ordered['GAME_DATE'] - ordered['PREV_GAME_DATE']).dt.days.fillna(0).clip(lower=0)\n",
    "    ordered['IS_B2B_CALC'] = (ordered['DAYS_REST_CALC'] == 0).astype(int)\n",
    "\n",
    "    indexed = ordered.set_index('GAME_DATE')\n",
    "    rolling_target = indexed.groupby('TEAM_ID')['GAME_ID']\n",
    "\n",
    "    for window, col_name in [(3, 'GAMES_IN_3D_CALC'), (5, 'GAMES_IN_5D_CALC'), (7, 'GAMES_IN_7D_CALC')]:\n",
    "        counts = rolling_target.rolling(f'{window}D', closed='left').count()\n",
    "        counts = counts.reset_index(level=0, drop=True)\n",
    "        temp_index = indexed['temp_index']\n",
    "        counts_reindexed = counts.reindex(temp_index.index).fillna(0)\n",
    "        counts_reindexed.index = temp_index.values\n",
    "        ordered[col_name] = ordered['temp_index'].map(counts_reindexed).fillna(0).astype(int)\n",
    "\n",
    "    ordered = ordered.drop(columns=['temp_index', 'PREV_GAME_DATE'])\n",
    "    frame = frame.drop(columns=calendar_cols, errors='ignore')\n",
    "    frame = frame.merge(\n",
    "        ordered[['TEAM_ID', 'GAME_DATE', 'GAME_ID'] + calendar_cols],\n",
    "        on=['TEAM_ID', 'GAME_DATE', 'GAME_ID'],\n",
    "        how='left'\n",
    "    )\n",
    "    print('Se calcularon las columnas retrospectivas sin fuga:', ', '.join(calendar_cols))\n",
    "    return frame\n",
    "\n",
    "\n",
    "df = compute_calendar_features(df)\n"
