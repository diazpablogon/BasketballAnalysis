   "source": [
    "# === Definición del conjunto Elo+ ===\n",
    "feature_sets_ext = {name: list(cols) for name, cols in feature_sets.items()}\n",
    "elo_plus_candidates = [\n",
    "    'DIFF_ELO_PRE', 'P_ELO_HOME',\n",
    "    'DIFF_GAMES_IN_3D', 'DIFF_GAMES_IN_5D', 'DIFF_GAMES_IN_7D',\n",
    "    'DIFF_DAYS_REST_CALC', 'B2B_ADVANTAGE_ELO',\n",
