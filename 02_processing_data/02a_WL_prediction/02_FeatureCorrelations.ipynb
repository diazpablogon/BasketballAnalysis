  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Elo Dinámico (sin fuga) — Integración y análisis en 02_FeaturesCorrelation\n",
    "\n",
    "El sistema Elo describe la fuerza relativa de cada equipo y evoluciona tras cada encuentro.\n",
    "Aquí lo calculamos cronológicamente sin fuga de información y lo integramos en el mismo flujo de correlaciones usado para el resto de features.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Calendario retrospectivo sin fuga\n",
    "\n",
    "Calculamos indicadores de descanso estrictamente retrospectivos por equipo antes de cada partido, preservando el orden cronológico original.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Calendario retrospectivo mínimo para Elo ===\n",
    "if 'TEAM_ID' not in df.columns:\n",
    "    raise KeyError('Se requiere la columna TEAM_ID para calcular el calendario retrospectivo.')\n",
    "game_dates = pd.to_datetime(df['GAME_DATE'], errors='coerce')\n",
    "try:\n",
    "    game_dates = game_dates.dt.tz_convert(None)\n",
    "except (TypeError, AttributeError):\n",
    "    pass\n",
    "try:\n",
    "    game_dates = game_dates.dt.tz_localize(None)\n",
    "except (TypeError, AttributeError):\n",
    "    pass\n",
    "df['GAME_DATE'] = game_dates\n",
    "\n",
    "rest_columns = [\n",
    "    'DAYS_REST_CALC', 'IS_B2B_CALC',\n",
    "    'GAMES_IN_3D_CALC', 'GAMES_IN_5D_CALC', 'GAMES_IN_7D_CALC',\n",
    "]\n",
    "for col in rest_columns:\n",
    "    if col not in df.columns:\n",
    "        df[col] = pd.NA\n",
    "\n",
    "sort_keys = [key for key in ['TEAM_ID', 'SEASON_YEAR', 'GAME_DATE', 'GAME_ID'] if key in df.columns]\n",
    "df_sorted = df.sort_values(sort_keys).copy()\n",
    "\n",
    "for team_id, group in df_sorted.groupby('TEAM_ID', sort=False):\n",
    "    prev_dates = group['GAME_DATE'].shift(1)\n",
    "    days_rest = (group['GAME_DATE'] - prev_dates).dt.days\n",
    "    days_rest = days_rest.clip(lower=0)\n",
    "    df.loc[group.index, 'DAYS_REST_CALC'] = days_rest\n",
    "\n",
    "    is_b2b = pd.Series(np.where(days_rest == 0, 1, 0), index=group.index).astype('Int64')\n",
    "    df.loc[group.index, 'IS_B2B_CALC'] = is_b2b\n",
    "\n",
    "    dates = group['GAME_DATE']\n",
    "    for window in (3, 5, 7):\n",
    "        counts = []\n",
    "        for idx, current_date in enumerate(dates):\n",
    "            if idx == 0:\n",
    "                counts.append(0)\n",
    "                continue\n",
    "            previous_dates = dates.iloc[:idx]\n",
    "            window_start = current_date - pd.Timedelta(days=window)\n",
    "            mask = (previous_dates >= window_start) & (previous_dates < current_date)\n",
    "            counts.append(int(mask.sum()))\n",
    "        counts_series = pd.Series(counts, index=group.index, dtype='Int64')\n",
    "        df.loc[group.index, f'GAMES_IN_{window}D_CALC'] = counts_series\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Elo dinámico sin fuga\n",
    "\n",
    "Actualizamos un Elo con arrastre moderado entre temporadas antes de cada partido y almacenamos los valores previos sin contaminar con resultados futuros.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Cálculo de Elo Dinámico sin fuga ===\n",
    "elo_columns = ['ELO_PRE_CALC', 'ELO_OPP_PRE_CALC', 'ELO_DIFF_PRE_CALC', 'P_ELO_HOME_CALC']\n",
    "for col in elo_columns:\n",
    "    if col not in df.columns:\n",
    "        df[col] = pd.NA\n",
    "\n",
    "team_elos = {}\n",
    "team_last_season = {}\n",
    "home_advantage = 60\n",
    "k_factor = 20\n",
    "\n",
    "sort_keys = [key for key in ['SEASON_YEAR', 'GAME_DATE', 'GAME_ID', 'TEAM_ID'] if key in df.columns]\n",
    "if 'GAME_ID' not in df.columns or 'TEAM_ID' not in df.columns:\n",
    "    raise KeyError('Se requieren GAME_ID y TEAM_ID para calcular Elo.')\n",
    "df_sorted = df.sort_values(sort_keys).copy()\n",
    "\n",
    "for game_id, game_rows in df_sorted.groupby('GAME_ID', sort=False):\n",
    "    if game_rows.empty:\n",
    "        continue\n",
    "\n",
    "    for idx, row in game_rows.iterrows():\n",
    "        team_id = row.get('TEAM_ID')\n",
    "        season_year = row.get('SEASON_YEAR')\n",
    "        if pd.isna(team_id):\n",
    "            continue\n",
    "        if team_id not in team_elos:\n",
    "            team_elos[team_id] = 1500.0\n",
    "            team_last_season[team_id] = season_year\n",
    "            continue\n",
    "        last_season = team_last_season.get(team_id)\n",
    "        if last_season is None:\n",
    "            team_last_season[team_id] = season_year\n",
    "        elif season_year is not None and season_year != last_season:\n",
    "            previous_elo = team_elos.get(team_id, 1500.0)\n",
    "            team_elos[team_id] = 1500.0 + 0.25 * (previous_elo - 1500.0)\n",
    "            team_last_season[team_id] = season_year\n",
    "\n",
    "    matchup_home = game_rows['MATCHUP'].str.contains('vs', case=False, na=False)\n",
    "    if 'IS_HOME' in game_rows.columns:\n",
    "        derived_home = game_rows['IS_HOME'].fillna(0).astype(int) == 1\n",
    "        if derived_home.sum() == 1:\n",
    "            matchup_home = derived_home\n",
    "    elif 'HOME_COURT' in game_rows.columns:\n",
    "        derived_home = game_rows['HOME_COURT'].fillna(0).astype(int) == 1\n",
    "        if derived_home.sum() == 1:\n",
    "            matchup_home = derived_home\n",
    "\n",
    "    home_indices = game_rows.index[matchup_home].tolist()\n",
    "    away_indices = game_rows.index[~matchup_home].tolist()\n",
    "    if len(home_indices) != 1 or len(away_indices) != 1:\n",
    "        matchup_home = game_rows['MATCHUP'].str.contains('vs', case=False, na=False)\n",
    "        home_indices = game_rows.index[matchup_home].tolist()\n",
    "        away_indices = game_rows.index[~matchup_home].tolist()\n",
    "    if len(home_indices) != 1 or len(away_indices) != 1:\n",
    "        continue\n",
    "\n",
    "    home_idx = home_indices[0]\n",
    "    away_idx = away_indices[0]\n",
    "\n",
    "    home_team = df.loc[home_idx, 'TEAM_ID']\n",
    "    away_team = df.loc[away_idx, 'TEAM_ID']\n",
    "    if pd.isna(home_team) or pd.isna(away_team):\n",
    "        continue\n",
    "\n",
    "    home_elo = team_elos.get(home_team, 1500.0)\n",
    "    away_elo = team_elos.get(away_team, 1500.0)\n",
    "\n",
    "    df.loc[home_idx, 'ELO_PRE_CALC'] = home_elo\n",
    "    df.loc[home_idx, 'ELO_OPP_PRE_CALC'] = away_elo\n",
    "    df.loc[home_idx, 'ELO_DIFF_PRE_CALC'] = home_elo - away_elo\n",
    "\n",
    "    df.loc[away_idx, 'ELO_PRE_CALC'] = away_elo\n",
    "    df.loc[away_idx, 'ELO_OPP_PRE_CALC'] = home_elo\n",
    "    df.loc[away_idx, 'ELO_DIFF_PRE_CALC'] = away_elo - home_elo\n",
    "\n",
    "    expected_home = 1.0 / (1.0 + 10 ** (-(home_elo + home_advantage - away_elo) / 400))\n",
    "    df.loc[home_idx, 'P_ELO_HOME_CALC'] = expected_home\n",
    "\n",
    "    result_home = df.loc[home_idx, TARGET_COLUMN]\n",
    "    result_away = df.loc[away_idx, TARGET_COLUMN]\n",
    "    if pd.isna(result_home) or pd.isna(result_away):\n",
    "        continue\n",
    "\n",
    "    expected_away = 1.0 - expected_home\n",
    "    k_scale = float(k_factor)\n",
    "    if 'PLUS_MINUS' in df.columns:\n",
    "        margin = df.loc[home_idx, 'PLUS_MINUS']\n",
    "        if pd.notna(margin):\n",
    "            k_scale *= max(1.0, np.log1p(abs(margin)))\n",
    "\n",
    "    home_new = home_elo + k_scale * (float(result_home) - expected_home)\n",
    "    away_new = away_elo + k_scale * (float(result_away) - expected_away)\n",
    "\n",
    "    team_elos[home_team] = home_new\n",
    "    team_elos[away_team] = away_new\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Proyección a nivel partido y unión con `match_df`\n",
    "\n",
    "Llevamos las métricas calculadas al nivel partido, derivamos diferenciales y las integramos en `match_df` solo cuando no existen previamente.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Proyección del Elo y descanso a nivel partido ===\n",
    "home_mask = df['MATCHUP'].str.contains('vs', case=False, na=False)\n",
    "if 'IS_HOME' in df.columns:\n",
    "    derived_home = df['IS_HOME'].fillna(0).astype(int) == 1\n",
    "    if derived_home.sum() > 0:\n",
    "        home_mask = derived_home\n",
    "elif 'HOME_COURT' in df.columns:\n",
    "    derived_home = df['HOME_COURT'].fillna(0).astype(int) == 1\n",
    "    if derived_home.sum() > 0:\n",
    "        home_mask = derived_home\n",
    "away_mask = ~home_mask\n",
    "\n",
    "home_cols = {\n",
    "    'ELO_PRE_CALC': 'HOME_ELO_PRE',\n",
    "    'DAYS_REST_CALC': 'HOME_DAYS_REST_CALC',\n",
    "    'IS_B2B_CALC': 'HOME_IS_B2B_CALC',\n",
    "    'GAMES_IN_3D_CALC': 'HOME_GAMES_IN_3D_CALC',\n",
    "    'GAMES_IN_5D_CALC': 'HOME_GAMES_IN_5D_CALC',\n",
    "    'GAMES_IN_7D_CALC': 'HOME_GAMES_IN_7D_CALC',\n",
    "    'P_ELO_HOME_CALC': 'P_ELO_HOME',\n",
    "}\n",
    "away_cols = {\n",
    "    'ELO_PRE_CALC': 'AWAY_ELO_PRE',\n",
    "    'DAYS_REST_CALC': 'AWAY_DAYS_REST_CALC',\n",
    "    'IS_B2B_CALC': 'AWAY_IS_B2B_CALC',\n",
    "    'GAMES_IN_3D_CALC': 'AWAY_GAMES_IN_3D_CALC',\n",
    "    'GAMES_IN_5D_CALC': 'AWAY_GAMES_IN_5D_CALC',\n",
    "    'GAMES_IN_7D_CALC': 'AWAY_GAMES_IN_7D_CALC',\n",
    "}\n",
    "\n",
    "home_df = df.loc[home_mask, ['GAME_ID'] + list(home_cols.keys())].rename(columns=home_cols)\n",
    "away_df = df.loc[away_mask, ['GAME_ID'] + list(away_cols.keys())].rename(columns=away_cols)\n",
    "\n",
    "elo_match = home_df.merge(away_df, on='GAME_ID', how='inner')\n",
    "elo_match['DIFF_ELO_PRE'] = elo_match['HOME_ELO_PRE'] - elo_match['AWAY_ELO_PRE']\n",
    "elo_match['DIFF_GAMES_IN_3D'] = elo_match['HOME_GAMES_IN_3D_CALC'] - elo_match['AWAY_GAMES_IN_3D_CALC']\n",
    "elo_match['DIFF_GAMES_IN_5D'] = elo_match['HOME_GAMES_IN_5D_CALC'] - elo_match['AWAY_GAMES_IN_5D_CALC']\n",
    "elo_match['DIFF_GAMES_IN_7D'] = elo_match['HOME_GAMES_IN_7D_CALC'] - elo_match['AWAY_GAMES_IN_7D_CALC']\n",
    "elo_match['DIFF_DAYS_REST_CALC'] = elo_match['HOME_DAYS_REST_CALC'] - elo_match['AWAY_DAYS_REST_CALC']\n",
    "\n",
    "home_b2b = elo_match['HOME_IS_B2B_CALC'].fillna(0).astype(int)\n",
    "away_b2b = elo_match['AWAY_IS_B2B_CALC'].fillna(0).astype(int)\n",
    "elo_match['B2B_ADVANTAGE_ELO'] = np.where((home_b2b == 1) & (away_b2b != 1), 1,\n",
    "                                          np.where((away_b2b == 1) & (home_b2b != 1), -1, 0))\n",
    "\n",
    "elo_feature_cols = [\n",
    "    'DIFF_ELO_PRE', 'P_ELO_HOME',\n",
    "    'DIFF_GAMES_IN_3D', 'DIFF_GAMES_IN_5D', 'DIFF_GAMES_IN_7D',\n",
    "    'DIFF_DAYS_REST_CALC', 'B2B_ADVANTAGE_ELO',\n",
    "]\n",
    "for col in elo_feature_cols:\n",
    "    if col in elo_match.columns:\n",
    "        elo_match[col] = pd.to_numeric(elo_match[col], errors='coerce')\n",
    "\n",
    "columns_to_add = [col for col in elo_feature_cols if col not in match_df.columns]\n",
    "if columns_to_add:\n",
    "    match_df = match_df.merge(elo_match[['GAME_ID'] + columns_to_add], on='GAME_ID', how='left')\n",
    "else:\n",
    "    print('No se añadieron nuevas columnas porque ya existían en match_df.')\n"
   ]
  },
  {
