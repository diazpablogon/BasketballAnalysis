   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# === Calendario retrospectivo mínimo (sin fuga) ===\n",
    "\n",
    "print(\"Normalizando GAME_DATE a datetime naive...\")\n",
    "game_dates = pd.to_datetime(df['GAME_DATE'], errors='coerce')\n",
    "if getattr(game_dates.dt, 'tz', None) is not None:\n",
    "    game_dates = game_dates.dt.tz_localize(None)\n",
    "df['GAME_DATE'] = game_dates\n",
    "\n",
    "sort_cols = ['TEAM_ID', 'SEASON_YEAR', 'GAME_DATE', 'GAME_ID']\n",
    "df_sorted = df.sort_values(sort_cols, kind='mergesort')\n",
    "\n",
    "rest_days = df_sorted.groupby('TEAM_ID')['GAME_DATE'].diff().dt.days\n",
    "rest_days = rest_days.clip(lower=0).fillna(0).astype(int)\n",
    "\n",
    "new_columns = {\n",
    "    'DAYS_REST_CALC': rest_days,\n",
    "    'IS_B2B_CALC': (rest_days == 0).astype(int),\n",
    "}\n",
    "\n",
    "windows = [3, 5, 7]\n",
    "for window in windows:\n",
    "    window_counts = []\n",
    "    for team_id, group in df_sorted.groupby('TEAM_ID', sort=False):\n",
    "        dates = group['GAME_DATE'].to_numpy()\n",
    "        counts = np.zeros(len(dates), dtype=int)\n",
    "        left = 0\n",
    "        for right in range(len(dates)):\n",
    "            while dates[right] - dates[left] > np.timedelta64(window, 'D'):\n",
    "                left += 1\n",
    "            counts[right] = right - left\n",
    "        window_counts.append(pd.Series(counts, index=group.index))\n",
    "    new_columns[f'GAMES_IN_{window}D_CALC'] = pd.concat(window_counts).astype(int)\n",
    "\n",
    "for col, series in new_columns.items():\n",
    "    df_sorted[col] = series\n",
    "    aligned = series.reindex(df.index)\n",
    "    if col in df.columns:\n",
    "        print(f\"Columna '{col}' ya existía; se mantiene el contenido previo.\")\n",
    "    else:\n",
    "        df[col] = aligned\n",
    "        print(f\"Columna '{col}' añadida al dataframe de team-games.\")\n",
    "\n",
    "preview_cols = [c for c in ['TEAM_NAME', 'TEAM_ABBREVIATION'] if c in df_sorted.columns]\n",
    "preview_cols += ['GAME_DATE', 'MATCHUP', 'GAME_ID', 'DAYS_REST_CALC', 'IS_B2B_CALC', 'GAMES_IN_3D_CALC', 'GAMES_IN_5D_CALC', 'GAMES_IN_7D_CALC']\n",
    "display(df_sorted[preview_cols].head())\n"
   ]
