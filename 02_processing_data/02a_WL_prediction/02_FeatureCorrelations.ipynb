  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Elo Dinámico (sin fuga) — Integración y análisis de correlaciones\n",
    "\n",
    "Calculamos un Elo dinámico siguiendo el mismo flujo del notebook, respetando el orden cronológico y evitando cualquier fuga de información. Este bloque añade un conjunto de variables \"Elo+\" para comparar el rendimiento estimado frente a las señales actuales del modelo.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Cálculo de calendario y Elo dinámico sin fuga ===\n",
    "elo_work_df = (\n",
    "    df.sort_values([\"SEASON_YEAR\", \"GAME_DATE\", \"GAME_ID\", \"TEAM_ID\"])\n",
    "    .copy()\n",
    ")\n",
    "elo_work_df[\"GAME_DATE\"] = pd.to_datetime(elo_work_df[\"GAME_DATE\"])\n",
    "\n",
    "elo_work_df[\"DAYS_REST_CALC\"] = elo_work_df.groupby(\"TEAM_ID\")[\"GAME_DATE\"].diff().dt.days\n",
    "elo_work_df[\"IS_B2B_CALC\"] = np.where(\n",
    "    elo_work_df[\"DAYS_REST_CALC\"].notna() & (elo_work_df[\"DAYS_REST_CALC\"] <= 1),\n",
    "    1.0,\n",
    "    0.0,\n",
    ")\n",
    "\n",
    "for window in (3, 5, 7):\n",
    "    elo_work_df[f\"GAMES_IN_{window}D_CALC\"] = 0.0\n",
    "\n",
    "def _count_recent_games(dates, window):\n",
    "    window_td = pd.Timedelta(days=window)\n",
    "    counts = []\n",
    "    start = 0\n",
    "    for i, date in enumerate(dates):\n",
    "        while start < i and dates[start] < date - window_td:\n",
    "            start += 1\n",
    "        counts.append(i - start)\n",
    "    return counts\n",
    "\n",
    "for team_id, group in elo_work_df.groupby(\"TEAM_ID\", sort=False):\n",
    "    dates = list(group[\"GAME_DATE\"])\n",
    "    for window in (3, 5, 7):\n",
    "        counts = _count_recent_games(dates, window)\n",
    "        elo_work_df.loc[group.index, f\"GAMES_IN_{window}D_CALC\"] = counts\n",
    "\n",
    "for col in [\"ELO_PRE\", \"ELO_OPP_PRE\", \"ELO_DIFF_PRE\", \"P_ELO_HOME\"]:\n",
    "    elo_work_df[col] = np.nan\n",
    "\n",
    "ELO_START = 1500.0\n",
    "SEASON_CARRY = 0.25\n",
    "K_FACTOR = 20.0\n",
    "HOME_ADVANTAGE = 75.0\n",
    "\n",
    "elo_ratings = {}\n",
    "last_season_played = {}\n",
    "\n",
    "game_groups = elo_work_df.groupby([\"SEASON_YEAR\", \"GAME_DATE\", \"GAME_ID\"], sort=False)\n",
    "for (_, _, game_id), game in game_groups:\n",
    "    if len(game) < 2:\n",
    "        continue\n",
    "\n",
    "    team_entries = []\n",
    "    for idx, row in game.iterrows():\n",
    "        team_id = row[\"TEAM_ID\"]\n",
    "        season = row[\"SEASON_YEAR\"]\n",
    "        prev_season = last_season_played.get(team_id)\n",
    "        if prev_season is None:\n",
    "            elo_ratings.setdefault(team_id, ELO_START)\n",
    "        elif prev_season != season:\n",
    "            elo_ratings[team_id] = ELO_START + (elo_ratings.get(team_id, ELO_START) - ELO_START) * SEASON_CARRY\n",
    "        last_season_played[team_id] = season\n",
    "        rating = elo_ratings.get(team_id, ELO_START)\n",
    "        matchup = str(row.get(\"MATCHUP\", \"\")) if pd.notna(row.get(\"MATCHUP\", \"\")) else \"\"\n",
    "        team_entries.append((idx, team_id, rating, matchup))\n",
    "\n",
    "    if len(team_entries) < 2:\n",
    "        continue\n",
    "\n",
    "    home_entry = None\n",
    "    away_entry = None\n",
    "    for entry in team_entries:\n",
    "        matchup_lower = entry[3].lower()\n",
    "        if \"vs\" in matchup_lower:\n",
    "            home_entry = entry\n",
    "        elif away_entry is None:\n",
    "            away_entry = entry\n",
    "    if home_entry is None:\n",
    "        home_entry = team_entries[0]\n",
    "    if away_entry is None:\n",
    "        away_entry = team_entries[1] if team_entries[0] == home_entry else team_entries[0]\n",
    "\n",
    "    home_idx, home_team, home_rating, _ = home_entry\n",
    "    away_idx, away_team, away_rating, _ = away_entry\n",
    "\n",
    "    p_home = 1.0 / (1.0 + 10 ** ((away_rating - (home_rating + HOME_ADVANTAGE)) / 400))\n",
    "\n",
    "    for idx, team_id, rating, _ in team_entries:\n",
    "        opp_rating = away_rating if team_id == home_team else home_rating\n",
    "        elo_work_df.at[idx, \"ELO_PRE\"] = rating\n",
    "        elo_work_df.at[idx, \"ELO_OPP_PRE\"] = opp_rating\n",
    "        elo_work_df.at[idx, \"ELO_DIFF_PRE\"] = rating - opp_rating\n",
    "        elo_work_df.at[idx, \"P_ELO_HOME\"] = p_home\n",
    "\n",
    "    home_row = game.loc[home_idx]\n",
    "    away_row = game.loc[away_idx]\n",
    "    home_result = 1.0 if str(home_row.get(\"WL\", \"\")).upper() == \"W\" else 0.0\n",
    "\n",
    "    plus_minus = home_row.get(\"PLUS_MINUS\", np.nan)\n",
    "    if pd.notna(plus_minus):\n",
    "        mov = abs(float(plus_minus))\n",
    "        mov_factor = np.log(max(mov, 1.0) + 1.0) * (2.2 / ((home_rating - away_rating) * 0.001 + 2.2))\n",
    "    else:\n",
    "        mov_factor = 1.0\n",
    "\n",
    "    delta = K_FACTOR * mov_factor * (home_result - p_home)\n",
    "    elo_ratings[home_team] = home_rating + delta\n",
    "    elo_ratings[away_team] = away_rating - delta\n",
    "\n",
    "team_level_columns = [\n",
    "    \"DAYS_REST_CALC\",\n",
    "    \"IS_B2B_CALC\",\n",
    "    \"GAMES_IN_3D_CALC\",\n",
    "    \"GAMES_IN_5D_CALC\",\n",
    "    \"GAMES_IN_7D_CALC\",\n",
    "    \"ELO_PRE\",\n",
    "    \"ELO_OPP_PRE\",\n",
    "    \"ELO_DIFF_PRE\",\n",
    "    \"P_ELO_HOME\",\n",
    "]\n",
    "for col in team_level_columns:\n",
    "    if col not in df.columns:\n",
    "        df[col] = np.nan\n",
    "    df.loc[elo_work_df.index, col] = elo_work_df[col]\n",
    "\n",
    "print(\"Columnas de calendario y Elo (nivel equipo) listas:\")\n",
    "print(team_level_columns)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Proyección a nivel partido y unión con match_df ===\n",
    "if 'match_df' not in globals():\n",
    "    raise RuntimeError('match_df debe estar disponible para generar las variables Elo a nivel partido.')\n",
    "\n",
    "team_columns = [\n",
    "    \"GAME_ID\",\n",
    "    \"TEAM_ID\",\n",
    "    \"MATCHUP\",\n",
    "    \"ELO_PRE\",\n",
    "    \"ELO_OPP_PRE\",\n",
    "    \"ELO_DIFF_PRE\",\n",
    "    \"P_ELO_HOME\",\n",
    "    \"DAYS_REST_CALC\",\n",
    "    \"IS_B2B_CALC\",\n",
    "    \"GAMES_IN_3D_CALC\",\n",
    "    \"GAMES_IN_5D_CALC\",\n",
    "    \"GAMES_IN_7D_CALC\",\n",
    "]\n",
    "available_team_columns = [col for col in team_columns if col in df.columns]\n",
    "team_level_features = df[available_team_columns].dropna(subset=[\"GAME_ID\"]).copy()\n",
    "\n",
    "home_mask = team_level_features[\"MATCHUP\"].str.contains(\"vs\", case=False, na=False)\n",
    "home_team = team_level_features[home_mask].copy()\n",
    "away_team = team_level_features[~home_mask].copy()\n",
    "\n",
    "home_team = home_team.rename(columns={\n",
    "    \"TEAM_ID\": \"HOME_TEAM_ID\",\n",
    "    \"MATCHUP\": \"MATCHUP_HOME\",\n",
    "    \"ELO_PRE\": \"ELO_PRE_HOME\",\n",
    "    \"ELO_OPP_PRE\": \"ELO_OPP_PRE_HOME\",\n",
    "    \"ELO_DIFF_PRE\": \"ELO_DIFF_PRE_HOME\",\n",
    "    \"P_ELO_HOME\": \"P_ELO_HOME_HOME\",\n",
    "    \"DAYS_REST_CALC\": \"DAYS_REST_CALC_HOME\",\n",
    "    \"IS_B2B_CALC\": \"IS_B2B_CALC_HOME\",\n",
    "    \"GAMES_IN_3D_CALC\": \"GAMES_IN_3D_CALC_HOME\",\n",
    "    \"GAMES_IN_5D_CALC\": \"GAMES_IN_5D_CALC_HOME\",\n",
    "    \"GAMES_IN_7D_CALC\": \"GAMES_IN_7D_CALC_HOME\",\n",
    "})\n",
    "away_team = away_team.rename(columns={\n",
    "    \"TEAM_ID\": \"AWAY_TEAM_ID\",\n",
    "    \"MATCHUP\": \"MATCHUP_AWAY\",\n",
    "    \"ELO_PRE\": \"ELO_PRE_AWAY\",\n",
    "    \"ELO_OPP_PRE\": \"ELO_OPP_PRE_AWAY\",\n",
    "    \"ELO_DIFF_PRE\": \"ELO_DIFF_PRE_AWAY\",\n",
    "    \"P_ELO_HOME\": \"P_ELO_HOME_AWAY\",\n",
    "    \"DAYS_REST_CALC\": \"DAYS_REST_CALC_AWAY\",\n",
    "    \"IS_B2B_CALC\": \"IS_B2B_CALC_AWAY\",\n",
    "    \"GAMES_IN_3D_CALC\": \"GAMES_IN_3D_CALC_AWAY\",\n",
    "    \"GAMES_IN_5D_CALC\": \"GAMES_IN_5D_CALC_AWAY\",\n",
    "    \"GAMES_IN_7D_CALC\": \"GAMES_IN_7D_CALC_AWAY\",\n",
    "})\n",
    "\n",
    "match_level_features = home_team.merge(away_team, on=\"GAME_ID\", how=\"inner\", suffixes=(\"_HOME\", \"_AWAY\"))\n",
    "\n",
    "match_level_features[\"DIFF_ELO_PRE\"] = match_level_features[\"ELO_PRE_HOME\"] - match_level_features[\"ELO_PRE_AWAY\"]\n",
    "match_level_features[\"DIFF_GAMES_IN_3D\"] = match_level_features[\"GAMES_IN_3D_CALC_HOME\"] - match_level_features[\"GAMES_IN_3D_CALC_AWAY\"]\n",
    "match_level_features[\"DIFF_GAMES_IN_5D\"] = match_level_features[\"GAMES_IN_5D_CALC_HOME\"] - match_level_features[\"GAMES_IN_5D_CALC_AWAY\"]\n",
    "match_level_features[\"DIFF_GAMES_IN_7D\"] = match_level_features[\"GAMES_IN_7D_CALC_HOME\"] - match_level_features[\"GAMES_IN_7D_CALC_AWAY\"]\n",
    "match_level_features[\"DIFF_DAYS_REST_CALC\"] = match_level_features[\"DAYS_REST_CALC_HOME\"] - match_level_features[\"DAYS_REST_CALC_AWAY\"]\n",
    "match_level_features[\"B2B_ADVANTAGE_ELO\"] = match_level_features[\"IS_B2B_CALC_HOME\"] - match_level_features[\"IS_B2B_CALC_AWAY\"]\n",
    "match_level_features[\"P_ELO_HOME\"] = match_level_features[\"P_ELO_HOME_HOME\"]\n",
    "\n",
    "elo_match_columns = [\n",
    "    \"GAME_ID\",\n",
    "    \"DIFF_ELO_PRE\",\n",
    "    \"P_ELO_HOME\",\n",
    "    \"DIFF_GAMES_IN_3D\",\n",
    "    \"DIFF_GAMES_IN_5D\",\n",
    "    \"DIFF_GAMES_IN_7D\",\n",
    "    \"DIFF_DAYS_REST_CALC\",\n",
    "    \"B2B_ADVANTAGE_ELO\",\n",
    "]\n",
    "existing_overlap = [col for col in elo_match_columns if col in match_df.columns and col != \"GAME_ID\"]\n",
    "if existing_overlap:\n",
    "    print(\"Las siguientes columnas ya existían en match_df y no se duplicarán:\", existing_overlap)\n",
    "    elo_match_columns = [col for col in elo_match_columns if col not in existing_overlap]\n",
    "\n",
    "elo_match_features = match_level_features[elo_match_columns].drop_duplicates(subset=[\"GAME_ID\"])\n",
    "match_df = match_df.merge(elo_match_features, on=\"GAME_ID\", how=\"left\")\n",
    "\n",
    "new_numeric_columns = [col for col in elo_match_columns if col != \"GAME_ID\" and col in match_df.columns]\n",
    "if new_numeric_columns:\n",
    "    match_df[new_numeric_columns] = match_df[new_numeric_columns].apply(pd.to_numeric, errors=\"coerce\")\n",
    "    print(\"Columnas Elo añadidas a match_df:\", new_numeric_columns)\n",
    "else:\n",
    "    print(\"No se añadieron columnas Elo nuevas a match_df.\")\n"
   ]
  },
