    "def build_model_tables(frame, feature_sets, target, model_order):\n",
    "    summaries = {}\n",
    "    cumulative = set()\n",
    "    for model_name in model_order:\n",
    "        features = [f for f in feature_sets.get(model_name, []) if f in frame.columns]\n",
    "        corr = compute_correlations(frame, features, target)\n",
    "        new_features = [f for f in features if f not in cumulative]\n",
    "        if corr.empty:\n",
    "            table = pd.DataFrame(columns=['Feature', 'Correlación', '|Correlación|', 'Es_nueva', 'Introducida_en']).set_index('Feature')\n",
    "        else:\n",
    "            table = (\n",
    "                corr.rename('Correlación').to_frame()\n",
    "                .assign(**{\n",
    "                    '|Correlación|': lambda df: df['Correlación'].abs(),\n",
    "                    'Es_nueva': lambda df: df.index.to_series().isin(new_features),\n",
    "                    'Introducida_en': model_name,\n",
    "                })\n",
    "                .sort_values('|Correlación|', ascending=False)\n",
    "            )\n",
    "            table.index.name = 'Feature'\n",
    "        summaries[model_name] = table\n",
    "        cumulative.update(features)\n",
    "    return summaries\n",
    "\n",
    "\n",
    "def display_model_tables(model_tables, model_order, top_n=15):\n",
    "    for model_name in model_order:\n",
    "        print(f\"=== {model_name} ===\")\n",
    "        table = model_tables.get(model_name)\n",
    "        if table is None or table.empty:\n",
    "            print('No hay correlaciones disponibles para este modelo.')\n",
    "            print()\n",
    "            continue\n",
    "        display(table.head(top_n))\n",
    "        print()\n",
    "\n",
    "\n",
    "def build_new_feature_overview(model_tables, model_order):\n",
    "    rows = []\n",
    "    for model_name in model_order:\n",
    "        table = model_tables.get(model_name)\n",
    "        if table is None or table.empty:\n",
    "            continue\n",
    "        new_rows = table[table['Es_nueva']].copy()\n",
    "        if new_rows.empty:\n",
    "            continue\n",
    "        new_rows = new_rows.reset_index().assign(Modelo=model_name)\n",
    "        rows.append(new_rows[['Modelo', 'Feature', 'Correlación', '|Correlación|']])\n",
    "    if not rows:\n",
    "        return pd.DataFrame(columns=['Modelo', 'Feature', 'Correlación', '|Correlación|'])\n",
    "    overview = pd.concat(rows, ignore_index=True)\n",
    "    return overview.sort_values('|Correlación|', ascending=False)\n",
    "    available = [f for f in features if f in frame.columns]\n",
    "    if not available:\n",
    "    ordered = frame[available + [target]].corr()[target].abs().sort_values(ascending=False).index.tolist()\n",
    "model_tables = build_model_tables(numeric_df, feature_sets, TARGET_COLUMN, MODEL_ORDER)\n",
    "display_model_tables(model_tables, MODEL_ORDER, top_n=15)\n",
    "new_feature_overview = build_new_feature_overview(model_tables, MODEL_ORDER)\n",
    "if new_feature_overview.empty:\n",
    "    print('No se añadieron nuevas features en los modelos incrementales.')\n",
    "else:\n",
    "    print('Resumen de correlaciones para las nuevas features introducidas por cada modelo:')\n",
    "    display(new_feature_overview)\n"
    "for model_name in MODEL_ORDER:\n",
    "    features = feature_sets.get(model_name, [])\n",
    "    plot_heatmap(numeric_df, features, TARGET_COLUMN, title, max_features=MAX_FEATURES_HEATMAP)\n"
    "Sintetizamos la evolución de las correlaciones al pasar del modelo Baseline al Venue+ y al Enhanced.\n"
