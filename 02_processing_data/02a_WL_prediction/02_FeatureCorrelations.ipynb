   "source": [
    "# === Proyección de Elo y descanso a nivel partido ===\n",
    "\n",
    "is_home = df['MATCHUP'].str.contains('vs', case=False, na=False)\n",
    "home_cols = [\n",
    "    'ELO_PRE', 'ELO_OPP_PRE', 'ELO_DIFF_PRE', 'P_ELO_HOME',\n",
    "    'DAYS_REST_CALC', 'IS_B2B_CALC', 'GAMES_IN_3D_CALC', 'GAMES_IN_5D_CALC', 'GAMES_IN_7D_CALC'\n",
    "]\n",
    "away_cols = [\n",
    "    'ELO_PRE', 'ELO_OPP_PRE', 'ELO_DIFF_PRE',\n",
    "    'DAYS_REST_CALC', 'IS_B2B_CALC', 'GAMES_IN_3D_CALC', 'GAMES_IN_5D_CALC', 'GAMES_IN_7D_CALC'\n",
    "]\n",
    "\n",
    "home_df = df[is_home].copy()\n",
    "away_df = df[~is_home].copy()\n",
    "\n",
    "home_df = home_df[['GAME_ID'] + [c for c in home_cols if c in home_df.columns]]\n",
    "away_df = away_df[['GAME_ID'] + [c for c in away_cols if c in away_df.columns]]\n",
    "\n",
    "home_df = home_df.rename(columns={col: f'HOME_{col}' for col in home_cols if col in home_df.columns})\n",
    "away_df = away_df.rename(columns={col: f'AWAY_{col}' for col in away_cols if col in away_df.columns})\n",
    "\n",
    "match_level = home_df.merge(away_df, on='GAME_ID', how='inner', suffixes=('', '_AWAY_DUP'))\n",
    "\n",
    "diff_map = {\n",
    "    'DIFF_ELO_PRE': ('HOME_ELO_PRE', 'AWAY_ELO_PRE'),\n",
    "    'DIFF_GAMES_IN_3D': ('HOME_GAMES_IN_3D_CALC', 'AWAY_GAMES_IN_3D_CALC'),\n",
    "    'DIFF_GAMES_IN_5D': ('HOME_GAMES_IN_5D_CALC', 'AWAY_GAMES_IN_5D_CALC'),\n",
    "    'DIFF_GAMES_IN_7D': ('HOME_GAMES_IN_7D_CALC', 'AWAY_GAMES_IN_7D_CALC'),\n",
    "    'DIFF_DAYS_REST_CALC': ('HOME_DAYS_REST_CALC', 'AWAY_DAYS_REST_CALC'),\n",
    "}\n",
    "for target_col, (home_col, away_col) in diff_map.items():\n",
    "    if home_col in match_level.columns and away_col in match_level.columns:\n",
    "        match_level[target_col] = match_level[home_col] - match_level[away_col]\n",
    "\n",
    "if 'HOME_P_ELO_HOME' in match_level.columns:\n",
    "    match_level['P_ELO_HOME'] = match_level['HOME_P_ELO_HOME']\n",
    "\n",
    "if 'HOME_IS_B2B_CALC' in match_level.columns and 'AWAY_IS_B2B_CALC' in match_level.columns:\n",
    "    match_level['B2B_ADVANTAGE_ELO'] = np.sign(\n",
    "        match_level['HOME_IS_B2B_CALC'] - match_level['AWAY_IS_B2B_CALC']\n",
    "    ).astype(int)\n",
    "\n",
    "elo_feature_columns = [\n",
    "    'DIFF_ELO_PRE', 'P_ELO_HOME',\n",
    "    'DIFF_GAMES_IN_3D', 'DIFF_GAMES_IN_5D', 'DIFF_GAMES_IN_7D',\n",
    "    'DIFF_DAYS_REST_CALC', 'B2B_ADVANTAGE_ELO'\n",
    "]\n",
    "available_elo_columns = [col for col in elo_feature_columns if col in match_level.columns]\n",
    "elo_match_df = match_level[['GAME_ID'] + available_elo_columns].drop_duplicates(subset='GAME_ID')\n",
    "for col in available_elo_columns:\n",
    "    elo_match_df[col] = pd.to_numeric(elo_match_df[col], errors='coerce')\n",
    "\n",
    "new_cols_for_merge = [col for col in available_elo_columns if col not in match_df.columns]\n",
    "if new_cols_for_merge:\n",
    "    match_df = match_df.merge(elo_match_df[['GAME_ID'] + new_cols_for_merge], on='GAME_ID', how='left')\n",
    "    for col in new_cols_for_merge:\n",
    "        match_df[col] = pd.to_numeric(match_df[col], errors='coerce')\n",
    "    print(f\"Se añadieron {len(new_cols_for_merge)} columnas nuevas al dataset de partidos: {', '.join(new_cols_for_merge)}\")\n",
    "else:\n",
    "    print('No se añadieron columnas nuevas; ya estaban presentes en match_df.')\n",
    "\n",
    "if available_elo_columns:\n",
    "    display(elo_match_df[['GAME_ID'] + available_elo_columns].head())\n"
   ]
