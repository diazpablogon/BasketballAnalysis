    "### Elo dinámico sin fuga\n",
    "Calculamos un Elo cronológico que se actualiza tras cada partido, conservando un 25% del rating final entre temporadas y registrando los valores previos a cada enfrentamiento.\n"
    "def compute_dynamic_elo(frame):\n",
    "    frame = frame.copy()\n",
    "    if 'SEASON_YEAR' not in frame.columns:\n",
    "        if 'GAME_DATE' not in frame.columns:\n",
    "            raise KeyError(\"Falta 'GAME_DATE' para derivar 'SEASON_YEAR'.\")\n",
    "        frame['GAME_DATE'] = pd.to_datetime(frame['GAME_DATE'])\n",
    "        season_mask = frame['GAME_DATE'].dt.month >= 10\n",
    "        frame['SEASON_YEAR'] = frame['GAME_DATE'].dt.year\n",
    "        frame.loc[~season_mask, 'SEASON_YEAR'] -= 1\n",
    "\n",
    "    required_cols = ['SEASON_YEAR', 'GAME_ID', 'TEAM_ID', 'MATCHUP']\n",
    "    missing_required = [col for col in required_cols if col not in frame.columns]\n",
    "    if missing_required:\n",
    "        raise KeyError(f\"Faltan columnas necesarias para el Elo dinámico: {missing_required}\")\n",
    "\n",
    "    for col in ['ELO_PRE', 'ELO_OPP_PRE', 'ELO_DIFF_PRE', 'P_ELO_HOME']:\n",
    "        if col not in frame.columns:\n",
    "            frame[col] = np.nan\n",
    "\n",
    "    ELO_START = 1500.0\n",
    "    HOME_ADVANTAGE_ELO = 60.0\n",
    "    K_FACTOR = 20.0\n",
    "    CARRYOVER_RATIO = 0.25\n",
    "\n",
    "    if not pd.api.types.is_datetime64_any_dtype(frame['GAME_DATE']):\n",
    "        frame['GAME_DATE'] = pd.to_datetime(frame['GAME_DATE'])\n",
    "\n",
    "    df_sorted = frame.sort_values(['SEASON_YEAR', 'GAME_DATE', 'GAME_ID', 'TEAM_ID']).copy()\n",
    "    elo_state = {}\n",
    "    last_season = {}\n",
    "\n",
    "    for (_, _, game_id), game_rows in df_sorted.groupby(['SEASON_YEAR', 'GAME_DATE', 'GAME_ID'], sort=False):\n",
    "        if len(game_rows) != 2:\n",
    "            continue\n",
    "        if 'IS_HOME' in game_rows.columns:\n",
    "            home_mask = game_rows['IS_HOME'].astype(bool)\n",
    "        else:\n",
    "            home_mask = game_rows['MATCHUP'].str.contains('vs', case=False, na=False)\n",
    "        if home_mask.sum() != 1:\n",
    "            home_mask = pd.Series([True, False], index=game_rows.index)\n",
    "\n",
    "        home_idx = game_rows.index[home_mask][0]\n",
    "        away_idx = game_rows.index[~home_mask][0]\n",
    "        participants = [home_idx, away_idx]\n",
    "\n",
    "        pre_elos = {}\n",
    "        for idx in participants:\n",
    "            row = df_sorted.loc[idx]\n",
    "            team = row['TEAM_ID']\n",
    "            season = row['SEASON_YEAR']\n",
    "            current_rating = elo_state.get(team)\n",
    "            if current_rating is None:\n",
    "                prev_season_rating = last_season.get(team, ELO_START)\n",
    "                current_rating = CARRYOVER_RATIO * prev_season_rating + (1 - CARRYOVER_RATIO) * ELO_START\n",
    "                elo_state[team] = current_rating\n",
    "            pre_elos[idx] = current_rating\n",
    "            last_season[team] = current_rating\n",
    "\n",
    "        home_pre = pre_elos[home_idx] + HOME_ADVANTAGE_ELO\n",
    "        away_pre = pre_elos[away_idx]\n",
    "        expected_home = 1 / (1 + 10 ** ((away_pre - home_pre) / 400))\n",
    "        expected_away = 1 - expected_home\n",
    "\n",
    "        home_score = df_sorted.at[home_idx, 'PTS'] if 'PTS' in df_sorted.columns else np.nan\n",
    "        away_score = df_sorted.at[away_idx, 'PTS'] if 'PTS' in df_sorted.columns else np.nan\n",
    "        if pd.isna(home_score) or pd.isna(away_score):\n",
    "            if 'WL' in df_sorted.columns:\n",
    "                home_wins = 1.0 if df_sorted.at[home_idx, 'WL'] == 'W' else 0.0\n",
    "                home_score = np.nan_to_num(home_wins, nan=expected_home)\n",
    "                away_score = 1.0 - home_score\n",
    "            else:\n",
    "                home_score = expected_home\n",
    "                away_score = expected_away\n",
    "        else:\n",
    "            home_score = 1.0 if home_score > away_score else 0.0\n",
    "            away_score = 1.0 - home_score\n",
    "        margin = df_sorted.at[home_idx, 'PLUS_MINUS'] if 'PLUS_MINUS' in df_sorted.columns else np.nan\n",
    "        k_home = K_FACTOR\n",
    "        k_away = K_FACTOR\n",
    "        if pd.notna(margin) and abs(margin) > 0:\n",
    "            margin_factor = np.log(abs(margin) + 1.0)\n",
    "            spread_term = 2.2 / (((home_pre - away_pre) * 0.001) + 2.2)\n",
    "            adjustment = margin_factor * spread_term\n",
    "            k_home *= adjustment\n",
    "            k_away *= adjustment\n",
    "        elo_state[df_sorted.at[home_idx, 'TEAM_ID']] = home_pre + k_home * (home_score - expected_home)\n",
    "        elo_state[df_sorted.at[away_idx, 'TEAM_ID']] = away_pre + k_away * (away_score - expected_away)\n",
    "        frame.loc[home_idx, ['ELO_PRE', 'ELO_OPP_PRE', 'ELO_DIFF_PRE', 'P_ELO_HOME']] = [home_pre, away_pre, home_pre - away_pre, expected_home]\n",
    "        frame.loc[away_idx, ['ELO_PRE', 'ELO_OPP_PRE', 'ELO_DIFF_PRE', 'P_ELO_HOME']] = [away_pre, home_pre, away_pre - home_pre, expected_away]\n",
    "    print('Se registraron los ratings Elo previos por equipo para cada partido.')\n",
    "    return frame\n",
    "df = compute_dynamic_elo(df)\n"
    "def build_match_level_elo(frame):\n",
    "    if 'IS_HOME' in frame.columns:\n",
    "        home_mask = frame['IS_HOME'].astype(bool)\n",
    "    else:\n",
    "        home_mask = frame['MATCHUP'].str.contains('vs', case=False, na=False)\n",
    "\n",
    "    home_cols = [\n",
    "        'GAME_ID', 'TEAM_ID', 'ELO_PRE', 'ELO_OPP_PRE', 'ELO_DIFF_PRE', 'P_ELO_HOME',\n",
    "        'DAYS_REST_CALC', 'GAMES_IN_3D_CALC', 'GAMES_IN_5D_CALC', 'GAMES_IN_7D_CALC', 'IS_B2B_CALC'\n",
    "    ]\n",
    "    away_cols = [col for col in home_cols if col != 'P_ELO_HOME']\n",
    "\n",
    "    missing_home = [c for c in home_cols if c not in frame.columns]\n",
    "    missing_away = [c for c in away_cols if c not in frame.columns]\n",
    "    if missing_home or missing_away:\n",
    "        raise KeyError(f\"Faltan columnas necesarias para proyectar a nivel partido. Home: {missing_home}, Away: {missing_away}\")\n",
    "\n",
    "    home_df = frame.loc[home_mask, home_cols].copy()\n",
    "    away_df = frame.loc[~home_mask, away_cols].copy()\n",
    "\n",
    "    home_df = home_df.rename(columns={\n",
    "        'TEAM_ID': 'HOME_TEAM_ID',\n",
    "        'ELO_PRE': 'HOME_ELO_PRE',\n",
    "        'ELO_OPP_PRE': 'HOME_ELO_OPP_PRE',\n",
    "        'ELO_DIFF_PRE': 'HOME_ELO_DIFF_PRE',\n",
    "        'DAYS_REST_CALC': 'HOME_DAYS_REST_CALC',\n",
    "        'GAMES_IN_3D_CALC': 'HOME_GAMES_IN_3D_CALC',\n",
    "        'GAMES_IN_5D_CALC': 'HOME_GAMES_IN_5D_CALC',\n",
    "        'GAMES_IN_7D_CALC': 'HOME_GAMES_IN_7D_CALC',\n",
    "        'IS_B2B_CALC': 'HOME_IS_B2B_CALC'\n",
    "    })\n",
    "    away_df = away_df.rename(columns={\n",
    "        'TEAM_ID': 'AWAY_TEAM_ID',\n",
    "        'ELO_PRE': 'AWAY_ELO_PRE',\n",
    "        'ELO_OPP_PRE': 'AWAY_ELO_OPP_PRE',\n",
    "        'ELO_DIFF_PRE': 'AWAY_ELO_DIFF_PRE',\n",
    "        'DAYS_REST_CALC': 'AWAY_DAYS_REST_CALC',\n",
    "        'GAMES_IN_3D_CALC': 'AWAY_GAMES_IN_3D_CALC',\n",
    "        'GAMES_IN_5D_CALC': 'AWAY_GAMES_IN_5D_CALC',\n",
    "        'GAMES_IN_7D_CALC': 'AWAY_GAMES_IN_7D_CALC',\n",
    "        'IS_B2B_CALC': 'AWAY_IS_B2B_CALC'\n",
    "    })\n",
    "    elo_match = home_df.merge(away_df, on='GAME_ID', how='inner')\n",
    "    elo_match['DIFF_ELO_PRE'] = elo_match['HOME_ELO_PRE'] - elo_match['AWAY_ELO_PRE']\n",
    "    elo_match['DIFF_GAMES_IN_3D'] = elo_match['HOME_GAMES_IN_3D_CALC'] - elo_match['AWAY_GAMES_IN_3D_CALC']\n",
    "    elo_match['DIFF_GAMES_IN_5D'] = elo_match['HOME_GAMES_IN_5D_CALC'] - elo_match['AWAY_GAMES_IN_5D_CALC']\n",
    "    elo_match['DIFF_GAMES_IN_7D'] = elo_match['HOME_GAMES_IN_7D_CALC'] - elo_match['AWAY_GAMES_IN_7D_CALC']\n",
    "    elo_match['DIFF_DAYS_REST_CALC'] = elo_match['HOME_DAYS_REST_CALC'] - elo_match['AWAY_DAYS_REST_CALC']\n",
    "\n",
    "    b2b_home = elo_match['HOME_IS_B2B_CALC']\n",
    "    b2b_away = elo_match['AWAY_IS_B2B_CALC']\n",
    "    elo_match['B2B_ADVANTAGE_ELO'] = np.where(\n",
    "        (b2b_home == 0) & (b2b_away == 1),\n",
    "        1,\n",
    "        np.where((b2b_home == 1) & (b2b_away == 0), -1, 0)\n",
    "    )\n",
    "    return elo_match\n",
    "elo_match = build_match_level_elo(df)\n",
    "MODEL_ORDER_EXT = MODEL_ORDER + ['Elo+']\n",
    "print(f\"Elo+ incluye {len(feature_sets_ext['Elo+'])} features (\n",
    "\"\n",
