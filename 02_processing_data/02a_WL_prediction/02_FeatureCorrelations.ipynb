   "source": [
    "# === Cálculo de Elo Dinámico sin fuga ===\n",
    "\n",
    "ELO_START = 1500\n",
    "ELO_CARRYOVER = 0.25\n",
    "HOME_ADVANTAGE = 60\n",
    "K_BASE = 20\n",
    "\n",
    "df_games = df.sort_values(['SEASON_YEAR', 'GAME_DATE', 'GAME_ID', 'TEAM_ID'], kind='mergesort')\n",
    "elo_pre = pd.Series(index=df_games.index, dtype=float)\n",
    "elo_opp_pre = pd.Series(index=df_games.index, dtype=float)\n",
    "elo_diff_pre = pd.Series(index=df_games.index, dtype=float)\n",
    "p_elo_home = pd.Series(index=df_games.index, dtype=float)\n",
    "\n",
    "elo_ratings = {}\n",
    "last_season_played = {}\n",
    "season_end_elo = {}\n",
    "\n",
    "game_schedule = (\n",
    "    df_games[['SEASON_YEAR', 'GAME_DATE', 'GAME_ID']]\n",
    "    .drop_duplicates()\n",
    "    .sort_values(['SEASON_YEAR', 'GAME_DATE', 'GAME_ID'], kind='mergesort')\n",
    ")\n",
    "\n",
    "for _, game_row in game_schedule.iterrows():\n",
    "    game_id = game_row['GAME_ID']\n",
    "    season = game_row['SEASON_YEAR']\n",
    "\n",
    "    game_entries = df_games[df_games['GAME_ID'] == game_id]\n",
    "    home_mask = game_entries['MATCHUP'].str.contains('vs', case=False, na=False)\n",
    "    if home_mask.sum() != 1 or len(game_entries) < 2:\n",
    "        continue\n",
    "\n",
    "    home_idx = game_entries[home_mask].index[0]\n",
    "    away_idx = game_entries[~home_mask].index[0]\n",
    "\n",
    "    home_team = df_games.loc[home_idx, 'TEAM_ID']\n",
    "    away_team = df_games.loc[away_idx, 'TEAM_ID']\n",
    "\n",
    "    for idx, team in [(home_idx, home_team), (away_idx, away_team)]:\n",
    "        last_season = last_season_played.get(team)\n",
    "        if last_season is None:\n",
    "            elo_ratings.setdefault(team, ELO_START)\n",
    "            last_season_played[team] = season\n",
    "        elif season != last_season:\n",
    "            carryover_value = season_end_elo.get(team, elo_ratings.get(team, ELO_START))\n",
    "            elo_ratings[team] = ELO_START * (1 - ELO_CARRYOVER) + carryover_value * ELO_CARRYOVER\n",
    "            last_season_played[team] = season\n",
    "\n",
    "    home_pre = float(elo_ratings.get(home_team, ELO_START))\n",
    "    away_pre = float(elo_ratings.get(away_team, ELO_START))\n",
    "\n",
    "    expected_home = 1.0 / (1.0 + 10 ** (((away_pre) - (home_pre + HOME_ADVANTAGE)) / 400))\n",
    "    expected_away = 1.0 - expected_home\n",
    "\n",
    "    home_result = float(df_games.loc[home_idx, TARGET_COLUMN])\n",
    "    away_result = float(df_games.loc[away_idx, TARGET_COLUMN])\n",
    "\n",
    "    margin = df_games.loc[home_idx, 'PLUS_MINUS'] if 'PLUS_MINUS' in df_games.columns else np.nan\n",
    "    if pd.notna(margin):\n",
    "        margin_multiplier = np.log(abs(margin) + 1.0) * (2.2 / ((abs(home_pre - away_pre) * 0.001) + 2.2))\n",
    "        K = K_BASE * max(1.0, margin_multiplier)\n",
    "    else:\n",
    "        K = K_BASE\n",
    "\n",
    "    elo_change_home = K * (home_result - expected_home)\n",
    "    home_post = home_pre + elo_change_home\n",
    "    away_post = away_pre + K * (away_result - expected_away)\n",
    "\n",
    "    elo_pre.loc[home_idx] = home_pre\n",
    "    elo_pre.loc[away_idx] = away_pre\n",
    "    elo_opp_pre.loc[home_idx] = away_pre\n",
    "    elo_opp_pre.loc[away_idx] = home_pre\n",
    "    elo_diff_pre.loc[home_idx] = home_pre - away_pre\n",
    "    elo_diff_pre.loc[away_idx] = away_pre - home_pre\n",
    "    p_elo_home.loc[home_idx] = expected_home\n",
    "\n",
    "    elo_ratings[home_team] = home_post\n",
    "    elo_ratings[away_team] = away_post\n",
    "    season_end_elo[home_team] = home_post\n",
    "    season_end_elo[away_team] = away_post\n",
    "\n",
    "elo_new_columns = {\n",
    "    'ELO_PRE': elo_pre,\n",
    "    'ELO_OPP_PRE': elo_opp_pre,\n",
    "    'ELO_DIFF_PRE': elo_diff_pre,\n",
    "    'P_ELO_HOME': p_elo_home,\n",
    "}\n",
    "\n",
    "for col, series in elo_new_columns.items():\n",
    "    df_games[col] = series\n",
    "    aligned = series.reindex(df.index)\n",
    "    if col in df.columns:\n",
    "        print(f\"Columna '{col}' ya existía; se mantiene el contenido previo.\")\n",
    "    else:\n",
    "        df[col] = aligned\n",
    "        print(f\"Columna '{col}' generada para el Elo dinámico.\")\n",
    "\n",
    "elo_preview_cols = [c for c in ['TEAM_NAME', 'TEAM_ABBREVIATION'] if c in df_games.columns]\n",
    "elo_preview_cols += ['GAME_DATE', 'MATCHUP', 'GAME_ID', 'ELO_PRE', 'ELO_OPP_PRE', 'ELO_DIFF_PRE', 'P_ELO_HOME']\n",
    "display(df_games.loc[elo_pre.dropna().index, elo_preview_cols].head())\n"
   ]
